{
  "components": {
    "schemas": {
      "CheckStatus": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "latencyMs": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ],
        "type": "object"
      },
      "HealthReport": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "additionalProperties": false,
            "properties": {
              "postgres": {
                "$ref": "#/components/schemas/CheckStatus"
              },
              "redis": {
                "$ref": "#/components/schemas/CheckStatus"
              }
            },
            "required": [
              "postgres",
              "redis"
            ],
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "myvideo_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "MyVideo API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            },
            "description": "All dependencies up"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            },
            "description": "At least one dependency down"
          }
        },
        "summary": "Dependency health (Postgres, Redis)",
        "tags": [
          "system"
        ]
      }
    }
  }
}
